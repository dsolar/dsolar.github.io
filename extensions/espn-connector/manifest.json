{
  "manifest_version": 3,
  "name": "Sports Data Nonsense \u2014 ESPN Connect",
  "version": "0.1.1",
  "description": "Read-only ESPN league updates for Rohan and the trade analyzer.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.espn.com/*",
    "https://baxrczyufqbzrogftmyn.supabase.co/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Connect an ESPN league"
  },
  "content_scripts": [
    {
      "matches": [
        "https://davidsolar.dev/trade-analyzer/*",
        "https://dsolar.github.io/trade-analyzer/*",
        "https://davidsolar.dev/rohan/*",
        "https://dsolar.github.io/rohan/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://baxrczyufqbzrogftmyn.supabase.co"
  },
  "minimum_chrome_version": "109"
}
